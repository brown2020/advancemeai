{
    "name": "advancemeai",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "test": "jest --passWithNoTests",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@ai-sdk/openai": "^4.0.108",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-popover": "^1.3.1",
        "ai": "^7.0.162",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "firebase": "^13.2.0",
        "firebase-admin": "^14.5.0",
        "lucide-react": "^1.68.0",
        "next": "^16.4.5",
        "openai": "^7.50.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@next/eslint-plugin-next": "^16.4.5",
        "@tailwindcss/postcss": "^4.3.4",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^10.14.0",
        "jest": "^30.5.2",
        "postcss": "^8.5.32",
        "tailwindcss": "^4.3.4",
        "ts-jest": "^29.4.15",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "jest": {
        "testEnvironment": "node",
        "passWithNoTests": true,
        "roots": [
            "<rootDir>/src"
        ],
        "testMatch": [
            "**/*.test.ts",
            "**/*.test.tsx"
        ],
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/src/$1"
        },
        "transform": {
            "^.+\\.tsx?$": [
                "ts-jest",
                {
                    "tsconfig": "tsconfig.jest.json"
                }
            ]
        }
    },
    "overrides": {
        "form-data": ">=4.0.5",
        "uuid": "11.1.1",
        "@grpc/grpc-js": ">=1.13.6",
        "glob": "14.0.3",
        "minimatch": "11.0.4",
        "jwks-rsa": {
            "jose": "5.10.0"
        }
    }
}
