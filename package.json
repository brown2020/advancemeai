{
    "name": "advancemeai",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "test": "jest --passWithNoTests",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage"
    },
    "dependencies": {
        "@ai-sdk/openai": "^3.0.53",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-radio-group": "^1.3.8",
        "ai": "^6.0.168",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "firebase": "^12.12.1",
        "firebase-admin": "^14.0.0",
        "jose": "^6.2.2",
        "lucide-react": "^1.20.0",
        "next": "^16.2.4",
        "openai": "^6.34.0",
        "react": "^19.2.5",
        "react-dom": "^19.2.5",
        "tailwind-merge": "^3.5.0",
        "zod": "^4.3.6",
        "zustand": "^5.0.12"
    },
    "devDependencies": {
        "@next/eslint-plugin-next": "^16.2.4",
        "@tailwindcss/postcss": "^4.2.4",
        "@types/jest": "^30.0.0",
        "@types/node": "^26.0.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "eslint": "^10.2.1",
        "jest": "^30.3.0",
        "jest-environment-jsdom": "^30.3.0",
        "postcss": "^8.5.10",
        "tailwindcss": "^4.2.4",
        "ts-jest": "^29.4.11",
        "typescript": "^6",
        "typescript-eslint": "^8.59.0"
    },
    "jest": {
        "testEnvironment": "node",
        "passWithNoTests": true,
        "roots": [
            "<rootDir>/src"
        ],
        "testMatch": [
            "**/*.test.ts",
            "**/*.test.tsx"
        ],
        "moduleNameMapper": {
            "^@/(.*)$": "<rootDir>/src/$1"
        },
        "transform": {
            "^.+\\.tsx?$": [
                "ts-jest",
                {
                    "tsconfig": "tsconfig.jest.json"
                }
            ]
        }
    },
    "overrides": {
        "form-data": ">=4.0.5",
        "uuid": "9.0.1"
    }
}
